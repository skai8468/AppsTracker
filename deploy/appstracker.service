# systemd unit for AppsTracker — one always-on process (API + dashboard + scheduler +
# Telegram long-poll bot). Install:
#   sudo cp deploy/appstracker.service /etc/systemd/system/appstracker.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now appstracker
# Logs: journalctl -u appstracker -f
[Unit]
Description=AppsTracker (API + dashboard + scheduler + Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appstracker
Group=appstracker
WorkingDirectory=/opt/appstracker/backend
# Bind to all interfaces: the VM has no public IP exposure to worry about (no GCP
# firewall rule opens 8100), and this is what lets the dashboard be reached at the VM's
# Tailscale IP from any device on the tailnet. Nothing outside the tailnet can reach it.
# --workers 1 is REQUIRED: the scheduler and Telegram poller are in-process singletons;
# extra workers would duplicate them (double Gmail polls, getUpdates conflicts).
ExecStart=/opt/appstracker/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100 --workers 1
Restart=always
RestartSec=5
# Secrets/config are read from backend/.env by pydantic-settings.

[Install]
WantedBy=multi-user.target
