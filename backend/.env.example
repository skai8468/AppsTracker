# --- Database ---
# Leave empty to use a local SQLite file (backend/jobtrack.sqlite). This is the default
# for both local dev and the single-VM deploy — the file persists on the VM's disk and is
# plenty for one user. Only set DATABASE_URL if you want an external Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobtrack  (also uncomment psycopg
# in requirements.txt).
DATABASE_URL=

# --- App ---
# Comma-separated origins allowed to call the API. Only needed for local dev, where the
# Next.js dev server (:3000) calls the API cross-origin. In the VM deploy the backend
# serves the built dashboard from its own origin, so CORS isn't exercised.
CORS_ORIGINS=http://localhost:3000
# Path to the built Next.js export served at /. Empty => auto-detect ../frontend/out.
FRONTEND_DIST=

# --- Scheduler intervals (minutes) ---
MCF_SCRAPE_INTERVAL_MIN=60
COMPANY_SCRAPE_INTERVAL_MIN=240
GMAIL_POLL_INTERVAL_MIN=5
ENABLE_SCHEDULER=true

# --- Gmail (read-only) ---
# Path to the OAuth client secrets downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the user's refresh token is stored after the one-time OAuth flow.
GMAIL_TOKEN_FILE=token.json
# Optional: paste the contents of token.json here instead of shipping the file. On boot
# the app writes it to GMAIL_TOKEN_FILE if that file is missing. On the VM you can just
# scp token.json onto the box (the disk persists), so this is usually left empty.
GMAIL_TOKEN_JSON=
# If true, the poller only logs matches and never changes application state.
GMAIL_DRY_RUN=false

# --- Telegram (long-polling — no webhook, no public endpoint needed) ---
TELEGRAM_BOT_TOKEN=
