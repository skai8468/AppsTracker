# --- Database ---
# Local dev defaults to a SQLite file if unset. In prod set the Postgres URL, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobtrack
DATABASE_URL=

# --- App ---
# Public base URL of the backend once deployed (used for OAuth + Telegram webhook).
PUBLIC_BASE_URL=http://localhost:8100
# Comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# --- Scheduler intervals (minutes) ---
MCF_SCRAPE_INTERVAL_MIN=60
COMPANY_SCRAPE_INTERVAL_MIN=240
GMAIL_POLL_INTERVAL_MIN=5
ENABLE_SCHEDULER=true

# --- Gmail (read-only) ---
# Path to the OAuth client secrets downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the user's refresh token is stored after the one-time OAuth flow.
GMAIL_TOKEN_FILE=token.json
# If true, the poller only logs matches and never changes application state.
GMAIL_DRY_RUN=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Secret path token appended to the webhook URL so only Telegram can call it.
TELEGRAM_WEBHOOK_SECRET=
